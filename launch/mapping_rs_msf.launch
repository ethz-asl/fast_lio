<launch>
<!-- Launch file for ouster OS2-64 LiDAR -->

    <arg name="rviz" default="false" />

    <rosparam command="load" file="$(find fast_lio)/config/rs_omav.yaml" />

    <param name="feature_extract_enable" type="bool" value="0"/>
    <param name="point_filter_num" type="int" value="1"/>
    <param name="max_iteration" type="int" value="5" />
    <param name="filter_size_surf" type="double" value="0.5" />
    <param name="filter_size_map" type="double" value="0.5" />
    <param name="cube_side_length" type="double" value="1000" />
    <param name="runtime_pos_log_enable" type="bool" value="0" />
    <node pkg="fast_lio" type="fastlio_mapping" name="laserMapping" output="screen" /> 

    <node name="msf_pose_sensor" pkg="msf_updates" type="pose_sensor" clear_params="true" output="screen">
        <!-- Config -->
        <rosparam file="$(find fast_lio)/config/airy_omav_msf.yaml" command="load"/>
        <!-- Remap -->
        <remap from="msf_core/imu_state_input" to="/imu"/> <!--$(arg rovio_imu_topic)"/ -->
        <remap from="msf_updates/odometry_input" to="/Odometry"/>
    </node>

    <group if="$(arg rviz)">
    <node launch-prefix="nice" pkg="rviz" type="rviz" name="rviz" args="-d $(find fast_lio)/rviz_cfg/loam_livox.rviz" />
    </group>

</launch>
